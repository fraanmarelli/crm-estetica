# ---------- Supabase (Project Settings > API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# "Publishable key" (sb_publishable_...) o, en proyectos viejos, la "anon key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret key" (sb_secret_...) o la "service_role". NUNCA con NEXT_PUBLIC_ adelante.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------- URL pública del CRM (sin barra final) ----------
APP_URL=https://crm-estetica.vercel.app

# ---------- Meta (developers.facebook.com > tu app) ----------
META_APP_ID=
META_APP_SECRET=
# ID de la configuración de "Facebook Login for Business" con el permiso ads_read
META_CONFIG_ID=
# La misma clave que DISPATCH_SECRET en Supabase (para sincronizar apenas se conecta una cuenta)
DISPATCH_SECRET=
